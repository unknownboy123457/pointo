# ====================================================================
# LRD PointCalc — Server Environment Configuration
# ====================================================================
# Copy this file to .env and insert your API credentials.
# NEVER commit .env to version control (.gitignore protects .env).

PORT=5500

# AI Vision API Credentials (Server-side ONLY — never exposed to client)
# Recommended: Google Gemini API (gemini-1.5-flash / gemini-2.0-flash)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Alternative: OpenAI API (gpt-4o-mini)
# Get a key at: https://platform.openai.com/
OPENAI_API_KEY=
